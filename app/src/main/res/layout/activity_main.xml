<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white">
    <androidx.fragment.app.FragmentContainerView android:id="@+id/container"
        android:layout_width="match_parent" android:layout_height="match_parent"/>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="68dp" android:layout_gravity="bottom"
        android:layout_marginStart="22dp" android:layout_marginEnd="22dp" android:layout_marginBottom="18dp"
        app:cardCornerRadius="34dp" app:cardElevation="14dp" app:cardBackgroundColor="@color/glass"
        app:strokeColor="#330B8A87" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="10dp">
            <FrameLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <ImageView android:id="@+id/ic_home" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:padding="12dp" android:src="@drawable/ic_home"/>
            </FrameLayout>
            <FrameLayout android:id="@+id/nav_add" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <ImageView android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center"
                    android:background="@drawable/bg_plus" android:padding="14dp" android:src="@drawable/ic_plus" app:tint="@color/white"/>
            </FrameLayout>
            <FrameLayout android:id="@+id/nav_drive" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <ImageView android:id="@+id/ic_drive" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:padding="12dp" android:src="@drawable/ic_cloud"/>
            </FrameLayout>
            <FrameLayout android:id="@+id/nav_settings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <ImageView android:id="@+id/ic_settings" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:padding="12dp" android:src="@drawable/ic_settings"/>
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
